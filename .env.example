# Copy to .env on the server and fill in. Never commit .env.
DOMAIN=example.ru
BASE_URL=https://example.ru
SECRET_KEY=generate-with-openssl-rand-hex-32
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-16
ADMIN_EMAILS=you@example.ru

# access
FREE_BETA=true
MONTHLY_PLAN_LIMIT=30
FREE_PLANS_PER_MONTH=3
BUDGET_PER_SITUATION_RUB=4.4
PRICE_PER_SEAT_RUB=1500
PACK_SIZE=10
PACK_PRICE_RUB=590

# mail (SMTP of your domain's mailbox, e.g. Yandex 360: smtp.yandex.ru, 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Наука побеждать <no-reply@example.ru>
SMTP_SSL=true

# language model: gigachat | yandex | fake
# Yandex AI Studio: API key of a service account with the ai.languageModels.user role
LLM_PROVIDER=yandex
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_B2B
GIGACHAT_LIGHT_MODEL=GigaChat-2
GIGACHAT_STRONG_MODEL=GigaChat-2-Pro
# put russian_trusted_root_ca.cer into deploy/certs and set:
GIGACHAT_CA_BUNDLE=/srv/certs/russian_trusted_root_ca.cer
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LIGHT_MODEL=aliceai-llm-flash/latest
YANDEX_STRONG_MODEL=aliceai-llm/latest
# rub per 1000 tokens incl. VAT, Yandex AI Studio November 2026
PRICE_LIGHT_IN_PER_1K=0.1
PRICE_LIGHT_OUT_PER_1K=0.2
PRICE_STRONG_IN_PER_1K=0.5
PRICE_STRONG_OUT_PER_1K=1.2

# Payments for new orders and legal documents
PAYMENT_PROVIDER=tbank
PERSONAL_DATA_OPERATOR=ip
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_TAXATION=
TBANK_VAT=
TBANK_FFD=1.05
MERCHANT_RKN_NUMBER=
# Optional public contact overrides. By default the site's existing contacts are used.
MERCHANT_EMAIL=
MERCHANT_PHONE=
MERCHANT_POSTAL_ADDRESS=

# YooKassa credentials for payments made through its old terminal
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
